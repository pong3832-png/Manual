# =============================================
# 자동화 공부 루트 .gitignore
# 블랙리스트 방식: 기본 전부 포함, 위험한 것만 제외
# =============================================

# ----- 환경변수 / 비밀 -----
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/secrets*.json
**/*token*

# ----- Python 캐시 -----
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/

# ----- Python 가상환경 -----
.venv/
venv/
tf311/

# ----- Node.js -----
node_modules/
**/node_modules/

# ----- 빌드 / 캐시 산출물 -----
.next/
**/.next/
.cache/
**/.cache/
.vercel/
**/.vercel/
**/dist/
**/build/

# ----- Chrome 브라우저 프로필 (세션/쿠키 민감) -----
**/Chrome*/
**/chrome-debug-profile/
toss_naver_profile/
toss_chatgpt_profile/
토스/

# ----- 로그 / 임시 파일 -----
*.log
**/logs/
**/temp_*
*.tmp
**/*.html.html

# ----- Jupyter 캐시 -----
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ----- Windows 잡동사니 -----
Thumbs.db
Desktop.ini

# ----- 런타임 상태 (루트) -----
runtime/

# ----- Gemini IDE -----
.gemini/

# ----- camp-platform 대용량/데이터 -----
camp-platform/public/campaigns.json
camp-platform/public/crawl-status.json
camp-platform/public/data-quality.json
camp-platform/public/ads.json
camp-platform/public/crawl-check.json
camp-platform/dev-server*.log
camp-platform/dev-server*.err
camp-platform/dev-server*.err.log
camp-platform/debug.log
camp-platform/*.png

# ----- 기타 제외 -----
-p/
